# ==============================================================================
# 🌉 JEEVAN SETU - API & ENVIRONMENT CONFIGURATION
# ==============================================================================
# Note: Primary APIs (OSM, ISRO Bhuvan, NASA FIRMS, Open-Meteo, OSRM, Nominatim)
# are 100% FREE and operate immediately with default endpoints without keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗺️ 1. MAPS & SATELLITE CONFIGURATION (8 APIs)
# ------------------------------------------------------------------------------
# Primary Open & Sovereign Tile Endpoints (No Key Required)
VITE_OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_OPENTOPOMAP_URL="https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png"
VITE_ESRI_IMAGERY_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
VITE_ISRO_BHUVAN_WMS_URL="https://bhuvan-vec1.nrsc.gov.in/bhuvan/gwc/service/wms"
VITE_NASA_FIRMS_BASE_URL="https://firms.modaps.eosdis.nasa.gov/api"
VITE_NASA_FIRMS_MAP_KEY="" # Optional free key from NASA FIRMS

# Enterprise & Commercial Fallback Keys (Optional)
VITE_GOOGLE_MAPS_API_KEY=""
VITE_MAPBOX_ACCESS_TOKEN=""
VITE_HERE_API_KEY=""
VITE_TOMTOM_API_KEY=""
VITE_SENTINEL_HUB_INSTANCE_ID=""

# ------------------------------------------------------------------------------
# 🌧️ 2. WEATHER & RADAR CONFIGURATION (2 APIs)
# ------------------------------------------------------------------------------
# Primary Weather Provider (100% Free, Open Source, No Key Required)
VITE_OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
VITE_OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1"

# Secondary Weather Fallback (Optional)
VITE_OPENWEATHERMAP_API_KEY=""

# ------------------------------------------------------------------------------
# 🤖 3. AI & MACHINE LEARNING CONFIGURATION (6 APIs)
# ------------------------------------------------------------------------------
# Primary Multimodal Disaster Copilot & Damage Triage
VITE_GEMINI_API_KEY=""

# Enterprise & LLM Fallbacks (Optional)
VITE_OPENAI_API_KEY=""
VITE_VERTEX_AI_PROJECT_ID=""
VITE_HUGGINGFACE_API_KEY=""

# ------------------------------------------------------------------------------
# 🔍 4. GEOCODING & ROUTING CONFIGURATION (4 APIs)
# ------------------------------------------------------------------------------
# Primary Geocoder & Turn-by-Turn Engine (100% Free, No Key Required)
VITE_NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
VITE_OSRM_ROUTING_BASE_URL="https://router.project-osrm.org"
VITE_OPENROUTESERVICE_API_KEY="" # Optional ORS fallback key
VITE_MAPILLARY_CLIENT_TOKEN=""   # Optional street imagery token
